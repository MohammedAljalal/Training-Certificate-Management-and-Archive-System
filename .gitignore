# ── Composer / Vendor ──────────────────────────────────────────────────────
vendor/
composer.phar

# ── Generated PDF Certificates (storage) ──────────────────────────────────
storage/certificates/*.pdf

# ── Environment files (never commit secrets) ──────────────────────────────
.env
.env.local
.env.*.local

# ── PHP config secrets (never commit credentials) ─────────────────────────
# config/db.php is included but mark as sensitive in README

# ── IDE & Editor files ────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
*.suo
*.user

# ── OS files ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
/logs/

# ── Temp / Cache ──────────────────────────────────────────────────────────
*.tmp
*.cache
/tmp/

# ── Node (if ever added) ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
