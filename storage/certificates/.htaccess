# NFR-09-SEC: Deny all direct HTTP access to certificate PDF files.
# PDF files are served exclusively through authenticated PHP download controllers.
# This .htaccess is a fallback for environments where storage/ cannot be placed
# above the document root.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
